{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Viewer",
  "version": "0.1.0",
  "identifier": "com.mdviewer",
  "build": {
    "beforeDevCommand": "npm run prepare:public",
    "beforeBuildCommand": "npm run prepare:public",
    "frontendDist": "../public"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "name": "Markdown",
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": [
          "net.daringfireball.markdown",
          "public.plain-text"
        ],
        "exportedType": {
          "identifier": "com.mdviewer.markdown",
          "conformsTo": [
            "net.daringfireball.markdown",
            "public.plain-text"
          ]
        }
      }
    ]
  }
}
